# Codebreakers environment variables.
#
# Copy to .env to override the local stack defaults in compose.yaml; Docker
# Compose reads .env automatically. Every value below is a placeholder for a
# disposable local stack. Never put real credentials in this file. .env is
# git-ignored and excluded from the image build context.

# --- Local stack (read by compose.yaml) ---------------------------------------

# Password for the local PostgreSQL container, which is not published to the host.
POSTGRES_PASSWORD=codebreakers-local

# Host port bound on 127.0.0.1 for the HTTP API.
CODEBREAKERS_API_PORT=8000

# --- Analysis limits and retry policy (API, worker, relay) --------------------

# Wall-clock budget for one analysis; the worker's stop_grace_period must exceed it.
CODEBREAKERS_ANALYSIS_TIME_BUDGET_SECONDS=30
# RLIMIT_AS for each analysis child process in MiB; 0 disables.
CODEBREAKERS_ANALYSIS_MEMORY_LIMIT_MB=1024
# Attempts before a job fails, with exponential backoff between retries.
CODEBREAKERS_WORKER_MAX_ATTEMPTS=5
CODEBREAKERS_WORKER_RETRY_BASE_SECONDS=2
CODEBREAKERS_WORKER_RETRY_MAX_SECONDS=60
# Days that finished analyses are kept before retention deletes them.
CODEBREAKERS_ANALYSIS_RETENTION_DAYS=7

# --- API abuse limits (API only; 0 disables a limit) --------------------------

# Requests per client IP per minute, per replica, across the API.
CODEBREAKERS_RATE_LIMIT_PER_MINUTE=120
# Analysis submissions per client IP per minute, per replica.
CODEBREAKERS_ANALYSIS_SUBMISSIONS_PER_MINUTE=10
# Unfinished (pending or running) analyses before new submissions get 503.
CODEBREAKERS_MAX_PENDING_ANALYSES=100

# --- Logging (all processes) ---------------------------------------------------

# json (default, one object per line) or text for readable local output.
CODEBREAKERS_LOG_FORMAT=json
CODEBREAKERS_LOG_LEVEL=INFO

# --- Set by compose.yaml for each container ------------------------------------
# Listed for running processes outside Compose (for example `codebreakers
# worker` on the host). Compose derives these values and ignores them here.

# in-process (default, no database required), postgres, or service-bus.
# CODEBREAKERS_ANALYSIS_QUEUE=postgres
# SQLAlchemy URL; postgresql:// selects the psycopg 3 driver.
# CODEBREAKERS_DATABASE_URL=postgresql://codebreakers:codebreakers-local@localhost:5432/codebreakers
# File touched by worker and relay loops for the container liveness probe.
# CODEBREAKERS_HEARTBEAT_FILE=/tmp/codebreakers.heartbeat

# --- Deployment identity and exposure (set by Terraform in Azure) -------------
# Tag on every log line; defaults to local. The revision is baked into the
# image at build time (Dockerfile CODEBREAKERS_REVISION).
# CODEBREAKERS_ENVIRONMENT=dev
# Reverse proxies in front of the API whose X-Forwarded-For entries are
# trusted for rate limiting: 0 locally (direct), 1 behind Container Apps ingress.
# CODEBREAKERS_TRUSTED_PROXY_HOPS=1
# GET /v1/analyses lists every job; Azure turns it off (404). Jobs stay
# readable by ID.
# CODEBREAKERS_ANALYSIS_LISTING_ENABLED=false

# --- Azure Service Bus (only when CODEBREAKERS_ANALYSIS_QUEUE=service-bus) ----
# CODEBREAKERS_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://example.servicebus.windows.net/;SharedAccessKeyName=fake;SharedAccessKey=fake
# CODEBREAKERS_SERVICEBUS_QUEUE=analysis-jobs

# --- Azure Monitor telemetry (set by Terraform in Azure; off when unset) ------
# AZURE_CLIENT_ID selects the user-assigned managed identity used to send
# telemetry. The Terraform-managed Application Insights rejects key-only
# ingestion, so the connection string alone sends nothing there.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://westus3-1.in.applicationinsights.azure.com/
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
