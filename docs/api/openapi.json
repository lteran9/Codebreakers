{
  "components": {
    "schemas": {
      "AnalysisJobResponse": {
        "description": "An analysis job resource.",
        "examples": [
          {
            "analyzer": "caesar-bruteforce",
            "completed_at": "2026-09-30T12:00:00.004Z",
            "created_at": "2026-09-30T12:00:00Z",
            "id": "0b8f6a3e-2d43-4c1e-9f55-6a1d2b7c9e10",
            "language": "english",
            "result": {
              "analyzer": "caesar-bruteforce",
              "candidates": [
                {
                  "explanation": "Shift 3 scored -69.2637 against english.",
                  "key": "3",
                  "rank": 1,
                  "score": -69.26,
                  "text": "THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG AND KEEPS RUNNING THROUGH THE FIELD"
                }
              ],
              "kind": "ranked-candidates",
              "language": "english",
              "language_version": "letter-frequency-v1"
            },
            "status": "succeeded"
          }
        ],
        "properties": {
          "analyzer": {
            "title": "Analyzer",
            "type": "string"
          },
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "frequency-report": "#/components/schemas/FrequencyReportResult",
                    "ranked-candidates": "#/components/schemas/RankedCandidatesResult",
                    "vigenere-key-analysis": "#/components/schemas/VigenereKeyAnalysisResult"
                  },
                  "propertyName": "kind"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/RankedCandidatesResult"
                  },
                  {
                    "$ref": "#/components/schemas/FrequencyReportResult"
                  },
                  {
                    "$ref": "#/components/schemas/VigenereKeyAnalysisResult"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "status": {
            "$ref": "#/components/schemas/AnalysisStatus"
          }
        },
        "required": [
          "id",
          "status",
          "analyzer",
          "language",
          "created_at",
          "completed_at",
          "result"
        ],
        "title": "AnalysisJobResponse",
        "type": "object"
      },
      "AnalysisRequest": {
        "additionalProperties": false,
        "description": "Ciphertext and analyzer selection for a keyless analysis.",
        "examples": [
          {
            "analyzer": "caesar-bruteforce",
            "language": "english",
            "text": "WKH TXLFN EURZQ IRA MXPSV RYHU WKH ODCB GRJ DQG NHHSV UXQQLQJ WKURXJK WKH ILHOG"
          }
        ],
        "properties": {
          "analyzer": {
            "description": "Analyzer to run. Supported: caesar-bruteforce, substitution-frequency, vigenere-frequency, homophonic-distribution.",
            "maxLength": 64,
            "minLength": 1,
            "title": "Analyzer",
            "type": "string"
          },
          "language": {
            "default": "english",
            "description": "Language model for scoring. Supported: english.",
            "maxLength": 64,
            "minLength": 1,
            "title": "Language",
            "type": "string"
          },
          "text": {
            "description": "Ciphertext to analyze.",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "analyzer",
          "text"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "AnalysisStatus": {
        "description": "Lifecycle states of an analysis job.",
        "enum": [
          "pending",
          "running",
          "succeeded",
          "failed"
        ],
        "title": "AnalysisStatus",
        "type": "string"
      },
      "CandidateModel": {
        "description": "A ranked candidate key and plaintext.",
        "properties": {
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Language score; null when the text has no scorable symbols.",
            "title": "Score"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "rank",
          "score",
          "key",
          "text",
          "explanation"
        ],
        "title": "CandidateModel",
        "type": "object"
      },
      "CipherOperationRequest": {
        "additionalProperties": false,
        "description": "Text, raw key, and alphabet for an encrypt or decrypt operation.",
        "examples": [
          {
            "key": "3",
            "text": "HELLO WORLD"
          }
        ],
        "properties": {
          "alphabet": {
            "default": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
            "description": "Unique alphabet symbols used by the cipher.",
            "maxLength": 1024,
            "title": "Alphabet",
            "type": "string"
          },
          "key": {
            "description": "Cipher key as a string: an integer shift (caesar), a keyword (vigenere), a cipher alphabet (substitution), or a JSON object (homophonic).",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "text": {
            "description": "Plaintext or ciphertext to transform.",
            "maxLength": 20000,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "key"
        ],
        "title": "CipherOperationRequest",
        "type": "object"
      },
      "CipherOperationResponse": {
        "description": "Result of an encrypt or decrypt operation.",
        "examples": [
          {
            "cipher": "caesar",
            "operation": "encrypt",
            "result": "KHOOR ZRUOG"
          }
        ],
        "properties": {
          "cipher": {
            "title": "Cipher",
            "type": "string"
          },
          "operation": {
            "enum": [
              "encrypt",
              "decrypt"
            ],
            "title": "Operation",
            "type": "string"
          },
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "cipher",
          "operation",
          "result"
        ],
        "title": "CipherOperationResponse",
        "type": "object"
      },
      "FrequencyReportResult": {
        "description": "Symbol or token frequency report.",
        "properties": {
          "analyzer": {
            "title": "Analyzer",
            "type": "string"
          },
          "comparisons": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Comparisons",
            "type": "object"
          },
          "kind": {
            "const": "frequency-report",
            "default": "frequency-report",
            "title": "Kind",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "language_version": {
            "title": "Language Version",
            "type": "string"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "title": "Notes",
            "type": "array"
          },
          "symbol_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Symbol Counts",
            "type": "object"
          },
          "symbol_frequencies": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Symbol Frequencies",
            "type": "object"
          }
        },
        "required": [
          "analyzer",
          "language",
          "language_version",
          "symbol_counts",
          "symbol_frequencies",
          "comparisons",
          "notes"
        ],
        "title": "FrequencyReportResult",
        "type": "object"
      },
      "KeyLengthCandidateModel": {
        "description": "A ranked Vigenere key-length estimate.",
        "properties": {
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "key_length": {
            "title": "Key Length",
            "type": "integer"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "score": {
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "rank",
          "key_length",
          "score",
          "explanation"
        ],
        "title": "KeyLengthCandidateModel",
        "type": "object"
      },
      "LivenessResponse": {
        "description": "Process liveness.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessResponse",
        "type": "object"
      },
      "ProblemDetails": {
        "description": "RFC 9457 problem details with machine-readable extensions.",
        "examples": [
          {
            "code": "invalid-key",
            "correlation_id": "4f1c2a8e-6c1b-4a51-9d7e-2b0f3f5b8c11",
            "detail": "Caesar key must be an integer.",
            "instance": "/v1/ciphers/caesar/encrypt",
            "status": 422,
            "title": "Invalid key",
            "type": "urn:codebreakers:problem:invalid-key"
          }
        ],
        "properties": {
          "code": {
            "description": "Stable machine-readable error code.",
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "description": "Matches the X-Request-ID header.",
            "title": "Correlation Id",
            "type": "string"
          },
          "detail": {
            "description": "Explanation specific to this occurrence.",
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Present for schema validation failures.",
            "title": "Errors"
          },
          "instance": {
            "description": "Request path that produced the problem.",
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code.",
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short, human-readable summary.",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "URI reference identifying the problem type.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "correlation_id"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "RankedCandidatesResult": {
        "description": "Candidates ranked by language score.",
        "properties": {
          "analyzer": {
            "title": "Analyzer",
            "type": "string"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CandidateModel"
            },
            "title": "Candidates",
            "type": "array"
          },
          "kind": {
            "const": "ranked-candidates",
            "default": "ranked-candidates",
            "title": "Kind",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "language_version": {
            "title": "Language Version",
            "type": "string"
          }
        },
        "required": [
          "analyzer",
          "language",
          "language_version",
          "candidates"
        ],
        "title": "RankedCandidatesResult",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Dependency readiness with per-check results.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "failing"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not-ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "A single schema validation failure, without the offending input value.",
        "properties": {
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "location",
          "message",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      },
      "VigenereKeyAnalysisResult": {
        "description": "Vigenere key-length estimates and candidate keys.",
        "properties": {
          "analyzer": {
            "title": "Analyzer",
            "type": "string"
          },
          "candidate_keys": {
            "items": {
              "$ref": "#/components/schemas/CandidateModel"
            },
            "title": "Candidate Keys",
            "type": "array"
          },
          "key_lengths": {
            "items": {
              "$ref": "#/components/schemas/KeyLengthCandidateModel"
            },
            "title": "Key Lengths",
            "type": "array"
          },
          "kind": {
            "const": "vigenere-key-analysis",
            "default": "vigenere-key-analysis",
            "title": "Kind",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "language_version": {
            "title": "Language Version",
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "minimum_useful_ciphertext_length": {
            "title": "Minimum Useful Ciphertext Length",
            "type": "integer"
          }
        },
        "required": [
          "analyzer",
          "language",
          "language_version",
          "key_lengths",
          "candidate_keys",
          "minimum_useful_ciphertext_length",
          "limitations"
        ],
        "title": "VigenereKeyAnalysisResult",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Encrypt, decrypt, and analyze text with classical ciphers. These ciphers are historically broken and provide no confidentiality; never use them to protect real secrets.",
    "title": "Codebreakers API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Report that the process is running.",
        "operationId": "get_liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Report whether dependencies needed to serve traffic are available.",
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Not ready"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/analyses": {
      "post": {
        "description": "Run a keyless analysis and return the resulting job resource.\n\nSmall analyses currently complete synchronously, so the job is returned in\na terminal state. Clients should still inspect `status`, because queued\nexecution will later return non-terminal jobs.",
        "operationId": "create_analysis",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisJobResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Submit an analysis",
        "tags": [
          "analyses"
        ]
      }
    },
    "/v1/analyses/{analysis_id}": {
      "get": {
        "description": "Return a previously submitted analysis job.\n\nJobs are held in process memory until durable persistence is added, so\nthey are lost on restart and the oldest are evicted at capacity.",
        "operationId": "get_analysis",
        "parameters": [
          {
            "in": "path",
            "name": "analysis_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Analysis Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisJobResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get an analysis",
        "tags": [
          "analyses"
        ]
      }
    },
    "/v1/ciphers/{cipher}/decrypt": {
      "post": {
        "description": "Decrypt text with the named cipher and key.",
        "operationId": "decrypt_text",
        "parameters": [
          {
            "description": "Registered cipher. Supported: caesar, substitution, vigenere, homophonic.",
            "in": "path",
            "name": "cipher",
            "required": true,
            "schema": {
              "description": "Registered cipher. Supported: caesar, substitution, vigenere, homophonic.",
              "examples": [
                "caesar"
              ],
              "maxLength": 64,
              "title": "Cipher",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CipherOperationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CipherOperationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Decrypt text",
        "tags": [
          "ciphers"
        ]
      }
    },
    "/v1/ciphers/{cipher}/encrypt": {
      "post": {
        "description": "Encrypt text with the named cipher and key.",
        "operationId": "encrypt_text",
        "parameters": [
          {
            "description": "Registered cipher. Supported: caesar, substitution, vigenere, homophonic.",
            "in": "path",
            "name": "cipher",
            "required": true,
            "schema": {
              "description": "Registered cipher. Supported: caesar, substitution, vigenere, homophonic.",
              "examples": [
                "caesar"
              ],
              "maxLength": 64,
              "title": "Cipher",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CipherOperationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CipherOperationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
